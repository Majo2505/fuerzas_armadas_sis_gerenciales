			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          id_efectivo_origen as integer,",
				"          nombre_completo as string,",
				"          genero as string,",
				"          fecha_nacimiento as date,",
				"          estado_civil as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT DISTINCT \\n\\n    id_efectivo AS id_efectivo_origen,\\n\\n    nombre AS nombre_completo,\\n\\n    genero,\\n\\n    fecha_nacimiento,\\n\\n    estado AS estado_civil\\n\\nFROM silver.tbl_efectivos\\n\\nWHERE id_efectivo IS NOT NULL',",
				"     format: 'query') ~> source1",
				"source(output(",
				"          id_rango_origen as integer,",
				"          nombre_rango as string,",
				"          categoria_rango as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT DISTINCT \\n    id_rango AS id_rango_origen,\\n    nombre AS nombre_rango,\\n    categoria AS categoria_rango\\nFROM silver.tbl_rangos\\nWHERE id_rango IS NOT NULL',",
				"     format: 'query') ~> source2",
				"source(output(",
				"          fecha_key as integer,",
				"          fecha as date,",
				"          dia_semana as integer,",
				"          nombre_dia as string,",
				"          dia_mes as integer,",
				"          mes as integer,",
				"          nombre_mes as string,",
				"          trimestre as integer,",
				"          semestre as integer,",
				"          anio as integer,",
				"          es_fin_semana as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT \\n    CAST(CONVERT(VARCHAR(8), s.fecha, 112) AS INT) AS fecha_key,\\n    CAST(s.fecha AS DATE) AS fecha,\\n    DATEPART(WEEKDAY, s.fecha) AS dia_semana,\\n    DATENAME(WEEKDAY, s.fecha) AS nombre_dia,\\n    DAY(s.fecha) AS dia_mes,\\n    MONTH(s.fecha) AS mes,\\n    DATENAME(MONTH, s.fecha) AS nombre_mes,\\n    DATEPART(QUARTER, s.fecha) AS trimestre,\\n    CASE WHEN MONTH(s.fecha) <= 6 THEN 1 ELSE 2 END AS semestre,\\n    YEAR(s.fecha) AS anio,\\n   CAST(CASE \\n        WHEN DATEPART(WEEKDAY, s.fecha) IN (1, 7) THEN 1 \\n        ELSE 0 \\n    END AS BIT) AS es_fin_semana\\nFROM (\\n    -- Fechas de Movimientos de Personal\\n    SELECT DISTINCT fecha_movimiento AS fecha\\n    FROM silver.tbl_movimientos_personal\\n    WHERE fecha_movimiento IS NOT NULL\\n    \\n    UNION\\n    \\n    -- Fechas de Inicio de Operaciones\\n    SELECT DISTINCT fecha_inicio AS fecha\\n    FROM silver.tbl_operaciones\\n    WHERE fecha_inicio IS NOT NULL\\n    \\n    UNION\\n    \\n    -- Fechas de Fin de Operaciones\\n    SELECT DISTINCT fecha_fin AS fecha\\n    FROM silver.tbl_operaciones\\n    WHERE fecha_fin IS NOT NULL\\n) s',",
				"     format: 'query') ~> source3",
				"source(output(",
				"          id_tipo_origen as integer,",
				"          descripcion_movimiento as string,",
				"          categoria_movimiento as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT DISTINCT \\n    id_tipo AS id_tipo_origen,\\n    nombre AS descripcion_movimiento,\\n    descripcion AS categoria_movimiento\\nFROM silver.tbl_tipos_movimiento\\nWHERE id_tipo IS NOT NULL',",
				"     format: 'query') ~> source4",
				"source(output(",
				"          id_tipo_origen as integer,",
				"          descripcion_operacion as string,",
				"          nivel_riesgo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT DISTINCT \\n    id_tipo AS id_tipo_origen,\\n    nombre AS descripcion_operacion,\\n    categoria AS nivel_riesgo\\nFROM silver.tbl_tipos_operacion\\nWHERE id_tipo IS NOT NULL',",
				"     format: 'query') ~> source5",
				"source(output(",
				"          id_zona_origen as integer,",
				"          nombre_zona as string,",
				"          tipo_terreno as string,",
				"          region_geografica as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT DISTINCT \\n    id_zona AS id_zona_origen,\\n    nombre AS nombre_zona,\\n    tipo_terreno,\\n    departamento AS region_geografica\\nFROM silver.tbl_zonas\\nWHERE id_zona IS NOT NULL',",
				"     format: 'query') ~> source6",
				"source(output(",
				"          id_unidad_origen as integer,",
				"          nombre_unidad as string,",
				"          codigo_unidad as string,",
				"          tipo_cuartel as string,",
				"          ciudad as string,",
				"          departamento as string,",
				"          nombre_brigada as string,",
				"          nombre_division as string,",
				"          nombre_rama as string,",
				"          sigla_rama as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT DISTINCT \\n    u.id_unidad AS id_unidad_origen,\\n    u.nombre AS nombre_unidad,\\n    u.codigo AS codigo_unidad,\\n    u.tipo_cuartel,\\n    u.ciudad,\\n    u.departamento,\\n    b.nombre AS nombre_brigada,\\n    d.nombre AS nombre_division,\\n    r.nombre AS nombre_rama,\\n    r.sigla AS sigla_rama\\nFROM silver.tbl_unidades u\\n-- Unimos para sacar la Brigada\\nLEFT JOIN silver.tbl_estructura_organizacional b \\n    ON u.id_brigada = b.id_estructura\\n-- Unimos la Brigada con su Padre (División)\\nLEFT JOIN silver.tbl_estructura_organizacional d \\n    ON b.id_padre = d.id_estructura\\n-- Unimos la División con su Padre (Rama)\\nLEFT JOIN silver.tbl_estructura_organizacional r \\n    ON d.id_padre = r.id_estructura\\nWHERE u.id_unidad IS NOT NULL',",
				"     format: 'query') ~> source7",
				"source1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          efectivo_key as integer,",
				"          id_efectivo_origen as integer,",
				"          nombre_completo as string,",
				"          genero as string,",
				"          fecha_nacimiento as date,",
				"          estado_civil as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          id_efectivo_origen,",
				"          nombre_completo,",
				"          genero,",
				"          fecha_nacimiento,",
				"          estado_civil",
				"     )) ~> sink1",
				"source2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          rango_key as integer,",
				"          id_rango_origen as integer,",
				"          nombre_rango as string,",
				"          categoria_rango as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          id_rango_origen,",
				"          nombre_rango,",
				"          categoria_rango",
				"     )) ~> sink2",
				"source3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          fecha_key as integer,",
				"          fecha as date,",
				"          dia_semana as integer,",
				"          nombre_dia as string,",
				"          dia_mes as integer,",
				"          mes as integer,",
				"          nombre_mes as string,",
				"          trimestre as integer,",
				"          semestre as integer,",
				"          anio as integer,",
				"          es_fin_semana as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          fecha_key,",
				"          fecha,",
				"          dia_semana,",
				"          nombre_dia,",
				"          dia_mes,",
				"          mes,",
				"          nombre_mes,",
				"          trimestre,",
				"          semestre,",
				"          anio,",
				"          es_fin_semana",
				"     )) ~> sink3",
				"source4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          tipo_movimiento_key as integer,",
				"          id_tipo_origen as integer,",
				"          descripcion_movimiento as string,",
				"          categoria_movimiento as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          id_tipo_origen,",
				"          descripcion_movimiento,",
				"          categoria_movimiento",
				"     )) ~> sink4",
				"source5 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          tipo_operacion_key as integer,",
				"          id_tipo_origen as integer,",
				"          descripcion_operacion as string,",
				"          nivel_riesgo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          id_tipo_origen,",
				"          descripcion_operacion,",
				"          nivel_riesgo",
				"     )) ~> sink5",
				"source6 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          zona_key as integer,",
				"          id_zona_origen as integer,",
				"          nombre_zona as string,",
				"          tipo_terreno as string,",
				"          region_geografica as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          id_zona_origen,",
				"          nombre_zona,",
				"          tipo_terreno,",
				"          region_geografica",
				"     )) ~> sink6",
				"source7 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          unidad_key as integer,",
				"          id_unidad_origen as integer,",
				"          nombre_unidad as string,",
				"          codigo_unidad as string,",
				"          tipo_cuartel as string,",
				"          ciudad as string,",
				"          departamento as string,",
				"          nombre_brigada as string,",
				"          nombre_division as string,",
				"          nombre_rama as string,",
				"          sigla_rama as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          id_unidad_origen,",
				"          nombre_unidad,",
				"          codigo_unidad,",
				"          tipo_cuartel,",
				"          ciudad,",
				"          departamento,",
				"          nombre_brigada,",
				"          nombre_division,",
				"          nombre_rama,",
				"          sigla_rama",
				"     )) ~> sink7"
			]
		}
	}
